{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spoolmap",
  "main": "./worker/src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "spoolmap.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "20260830",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
